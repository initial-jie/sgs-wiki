+		return new URL(path, document.baseURI).href;
+	}
+
+	/** 静态托管常见的 SPA 回退：缺失路径返回 index.html（200, text/html），需视为不存在。 */
+	looksLikeFallbackHtml(path, response) {
+		const type = (response.headers.get("content-type") || "").toLowerCase();
+		return type.includes("text/html") && !/\.html?$/i.test(path);
+	}
+
+	readOnlyError(path) {
+		return createFileSystemError(FileSystemErrorCode.IoError, path, "Static hosting is read-only");
+	}
