+/**
+ * 只读静态适配器：面向纯静态托管（无 /checkFile 等后端）。
+ * @implements { FileSystemAdapter }
+ */
+class StaticReadOnlyAdapter {
+	async open(path, options = {}) {
+		assertValidPath(path);
+		if (options.write || options.append || options.create || options.createNew || options.truncate) {
+			throw this.readOnlyError(path);
+		}
+		const info = await this.stat(path);
+		if (info === null) {
+			throw createFileSystemError(FileSystemErrorCode.NotFound, path, "File does not exist");
+		}
+		if (info.type !== "file") {
+			throw createFileSystemError(FileSystemErrorCode.NotFile, path, "Path is not a file");
+		}
+		return new BrowserFileHandle(this, path, true, false, false);
+	}
+
+	async read(path) {
+		assertValidPath(path);
+		let response;
+		try {
+			response = await fetch(this.toURL(path), { cache: "no-cache" });
+		} catch (error) {
+			throw toFileSystemError(error, path);
+		}
+		if (!response.ok || this.looksLikeFallbackHtml(path, response)) {
+			throw createFileSystemError(FileSystemErrorCode.NotFound, path, `HTTP ${response.status}`);
+		}
+		return new Uint8Array(await response.arrayBuffer());
+	}
+
+	async write(path) {
+		throw this.readOnlyError(path);
+	}
+
+	async stat(path) {
+		assertValidPath(path);
+		let response;
+		try {
+			response = await fetch(this.toURL(path), { method: "HEAD", cache: "no-cache" });
+			if (response.status === 405 || response.status === 501) {
+				response = await fetch(this.toURL(path), { cache: "no-cache" });
+			}
+		} catch (error) {
+			throw toFileSystemError(error, path);
+		}
+		if (!response.ok || this.looksLikeFallbackHtml(path, response)) {
+			return null;
+		}
+		return { type: path.endsWith("/") ? "directory" : "file" };
+	}
+
+	async list(path) {
+		assertValidPath(path);
+		// 静态托管无法列目录；返回空列表让“自动导入扩展”等逻辑静默跳过。
+		return [];
+	}
+
+	async createDir(path) {
+		throw this.readOnlyError(path);
+	}
+
+	async remove(path) {
+		throw this.readOnlyError(path);
+	}
+
+	toURL(path) {
+		return new URL(path, document.baseURI).href;
+	}
+
+	/** 静态托管常见的 SPA 回退：缺失路径返回 index.html（200, text/html），需视为不存在。 */
+	looksLikeFallbackHtml(path, response) {
+		const type = (response.headers.get("content-type") || "").toLowerCase();
+		return type.includes("text/html") && !/\.html?$/i.test(path);
+	}
+
+	readOnlyError(path) {
+		return createFileSystemError(FileSystemErrorCode.IoError, path, "Static hosting is read-only");
+	}
+}
+
 /**
  * @implements { FileSystemAdapter }
  */
